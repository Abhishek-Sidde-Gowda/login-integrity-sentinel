# Copy to .env and fill in. If using the Docker Splunk instance (see
# docs/splunk-docker.md), SPLUNK_HEC_URL/SPLUNK_MGMT_URL/SPLUNK_USER
# below are already correct as-is; only the token and password change.
SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_MGMT_URL=https://localhost:8089
SPLUNK_USER=admin
SPLUNK_PASSWORD=
